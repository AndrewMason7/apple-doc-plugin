{
	"name": "apple-doc-mcp-server",
	"version": "1.0.0",
	"description": "MCP server providing seamless access to Apple Developer Documentation with smart search and wildcard support",
	"main": "dist/index.js",
	"type": "module",
	"bin": {
		"apple-doc-mcp-server": "dist/index.js"
	},
	"files": [
		"dist/",
		"data/apple-docs.db",
		"bin/launcher.cjs",
		"plugin.json",
		"mcp_config.json",
		"skills/",
		"rules/",
		"README.md",
		"LICENSE"
	],
	"keywords": [
		"mcp",
		"apple",
		"documentation",
		"ios",
		"macos",
		"swiftui",
		"uikit"
	],
	"author": "Andrew Mason (https://github.com/AndrewMason7)",
	"repository": {
		"type": "git",
		"url": "https://github.com/AndrewMason7/apple-doc-plugin.git"
	},
	"bugs": {
		"url": "https://github.com/AndrewMason7/apple-doc-plugin/issues"
	},
	"homepage": "https://github.com/AndrewMason7/apple-doc-plugin#readme",
	"scripts": {
		"build": "tsc && chmod +x dist/index.js",
		"build:index": "tsx scripts/build-index.ts",
		"test": "npm run build && node --test test/**/*.test.js",
		"typecheck": "tsc --noEmit",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check": "npm run typecheck && npm run format:check",
		"start": "node dist/index.js",
		"plugin:validate": "agy plugin validate .",
		"plugin:install": "agy plugin install ."
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.27.1",
		"axios": "^1.13.6",
		"better-sqlite3": "^13.0.3",
		"google-auth-library": "^11.1.0"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "25.5.0",
		"prettier": "^3.8.1",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3"
	}
}

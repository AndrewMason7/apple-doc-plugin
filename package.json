{
	"name": "apple-doc-plugin",
	"version": "1.0.4",
	"description": "MCP server providing seamless access to Apple Developer Documentation with smart search and wildcard support",
	"main": "dist/index.js",
	"type": "module",
	"bin": {
		"apple-doc-plugin": "dist/index.js"
	},
	"files": [
		"dist/",
		"data/apple-docs.db",
		"assets/",
		"bin/",
		"plugin.json",
		"plugin.yaml",
		"__init__.py",
		"bridges/",
		"mcp_config.json",
		"skills/",
		"rules/",
		"README.md",
		"LICENSE"
	],
	"keywords": [
		"mcp",
		"apple",
		"documentation",
		"ios",
		"macos",
		"swiftui",
		"uikit"
	],
	"author": "Andrew Mason (https://github.com/AndrewMason7)",
	"repository": {
		"type": "git",
		"url": "https://github.com/AndrewMason7/apple-doc-plugin.git"
	},
	"bugs": {
		"url": "https://github.com/AndrewMason7/apple-doc-plugin/issues"
	},
	"homepage": "https://github.com/AndrewMason7/apple-doc-plugin#readme",
	"scripts": {
		"clean": "node -e \"const fs = require('fs'); fs.rmSync('dist', { recursive: true, force: true })\"",
		"build": "npm run clean && tsc && chmod +x dist/index.js",
		"prepublishOnly": "npm run check && npm test",
		"build:index": "tsx scripts/build-index.ts",
		"repair-index": "tsx scripts/repair-index.ts",
		"test": "npm run build && node --test test/**/*.test.js",
		"test:python": "pytest test/python/",
		"test:all": "npm test && npm run test:python",
		"typecheck": "tsc --noEmit",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check": "npm run typecheck && npm run format:check",
		"start": "node dist/index.js",
		"plugin:validate": "agy plugin validate .",
		"plugin:install": "agy plugin install .",
		"embed-index": "tsx scripts/embed-index.ts",
		"download-model": "tsx scripts/download-model.ts",
		"download-vectors": "tsx scripts/download-vectors.ts",
		"doctor": "tsx scripts/doctor.ts",
		"setup": "node dist/index.js setup",
		"install:ide": "node dist/index.js install",
		"export-vectors": "tsx scripts/export-vectors.ts",
		"index-xcode": "node dist/index.js index-xcode",
		"build:binary": "scripts/build-binary.sh"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.27.1",
		"axios": "^1.13.6",
		"better-sqlite3": "^13.0.3",
		"google-auth-library": "^11.1.0",
		"node-llama-cpp": "^3.22.2",
		"sqlite-vec": "^0.1.9"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "25.5.0",
		"prettier": "^3.8.1",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3"
	},
	"engines": {
		"node": ">=22"
	}
}

# ==============================================================================
# Apple Doc MCP Server - Environment Configuration
# ==============================================================================

# Google Gemini API key for multimodal embeddings (models/gemini-embedding-2).
# When provided, enables 3072-dimensional vector semantic search and Apple DocC
# visual diagram & layout preview embeddings.
# Get an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Optional: Path to custom SQLite database file (defaults to data/apple-docs.db)
# APPLE_DOCS_DB_PATH=./data/apple-docs.db

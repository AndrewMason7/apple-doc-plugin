# ==============================================================================
# Apple Doc MCP Server - Environment Configuration
# ==============================================================================

# Authentication Option 1: API Key
# Google Gemini API key for multimodal embeddings (models/gemini-embedding-2).
# When provided, enables 3072-dimensional vector semantic search and Apple DocC
# visual diagram & layout preview embeddings.
# Get an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Authentication Option 2: Application Default Credentials (ADC)
# If GEMINI_API_KEY is not set, the server automatically looks for Google ADC:
# - Service Account JSON via GOOGLE_APPLICATION_CREDENTIALS path
# - gcloud user credentials via `gcloud auth application-default login`
# - Workload Identity / GCE / GKE / Cloud Run metadata servers
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Optional: Custom SQLite database file (defaults to data/apple-docs.db)
# APPLE_DOCS_DB_PATH=./data/apple-docs.db

# ==============================================================================
# Local Embedding Model (100% Offline via node-llama-cpp)
# ==============================================================================
# Embedding Option 1: In-process local GGUF model (Google DeepMind EmbeddingGemma 2)
# Generates 768-dimensional embeddings locally with Apple Silicon Metal acceleration.
# When the model file exists, it is automatically selected as the default provider.
# APPLE_DOCS_EMBEDDING_MODEL_PATH=/path/to/embeddinggemma-2-Q8_0.gguf

# Force provider selection: 'local' (force local GGUF) or 'gemini' (force Gemini API)
# APPLE_DOCS_EMBEDDING_PROVIDER=local
# Optional MRL truncation for hosted embeddings (128|256|512|768|1024|1536|2048|3072):
# APPLE_DOCS_EMBEDDING_DIMENSIONS=768
